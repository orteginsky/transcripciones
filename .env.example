# --- GCP / Service Account ---
GCP_PROJECT_ID=tu-proyecto-gcp
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/abs/path/sa_key.json

# --- GCS Storage ---
GCS_BUCKET=mi-bucket-salida
GCS_BUCKET_OUTPUT=mi-bucket-salida/audio_output
USE_GCS=true
GCS_UPLOAD_CHUNK_MB=64

# --- Speech-to-Text v2 (único motor soportado) ---
STT_LANGUAGE_CODE=es-MX
STT_ENABLE_DIARIZATION=true
STT_MIN_SPEAKERS=2
STT_MAX_SPEAKERS=2
SPEECH_LOCATION=global
SPEECH_RECOGNIZER=

# --- Rutas locales ---
INPUT_DIR=./data/input
WORK_DIR=./data/work
OUTPUT_DIR=./data/output
MP3_SOURCE_DIR=./data/mp3
WAV_OUTPUT_DIR=./data/wav16k

# --- Audio Processing ---
NORMALIZE_TARGET_DB=-20
SILENCE_THRESHOLD=0.01

# --- Prompts ---
TRANSCRIPTION_PROMPT_FILE=./src/domain/prompts/transcription_prompt.md.j2

# --- PDF (opcional) ---
PDF_FOOTER_TEXT=Generado por TMF Audio Transcription
PDF_HEADER_TEXT=
