# --- GCP / Vertex ---
GCP_PROJECT_ID=ortega-473114
GCP_REGION=us-central1
GCS_BUCKET=my-bucket-out
GCS_BUCKET_OUTPUT=my-bucket-out/audio_output
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service_account.json

# Modelos (vía Vertex Model Garden)
VERTEX_MODEL_PUBLISHER=anthropic
VERTEX_MODEL_NAME=claude-3-5-sonnet
VERTEX_TEMPERATURE=0.2
VERTEX_MAX_TOKENS=4000

# Speech-to-Text
STT_ENGINE=google
STT_LANGUAGE_CODE=es-MX
STT_ENABLE_DIARIZATION=false

# Storage
USE_GCS=true
GCS_BUCKET=my-bucket-out

# Rutas locales
INPUT_DIR=./data/input
WORK_DIR=./data/work
OUTPUT_DIR=./data/output

# PDF
PDF_FOOTER_TEXT=vertex_audio_report

# Audio
MP3_SOURCE_DIR=./data/mp3          # carpeta donde buscar los mp3 originales
WAV_OUTPUT_DIR=./data/wav16k       # carpeta para guardar los wav normalizados
NORMALIZE_TARGET_DB=-20            # nivel de normalización (ej. -20 dBFS)
SILENCE_THRESHOLD=0.01             # umbral de silencio para segmentación (fracción del nivel máximo)

# --- Google OAuth2 (Sheets/Drive) ---
GEMINI_API_KEY=AIzaSyBGn5lY9pUQedFnLGsrrE3cFOU-DiHWJk4
GOOGLE_OAUTH_CREDENTIALS_FILE=./credentials/credentials.json
GOOGLE_OAUTH_TOKEN_FILE=./credentials/token.json

# Prompts
TRANSCRIPTION_PROMPT_FILE=./src/domain/prompts/transcription_prompt.md.j2

# Speech v2
SPEECH_LOCATION=global
SPEECH_RECOGNIZER=
TRANSCRIBER=gemini_vertex

