# --- GCP / Service Account ---
GCP_PROJECT_ID=ortega-473114
GCP_REGION=global
GOOGLE_APPLICATION_CREDENTIALS=./credentials/sa_key.json

# --- GCS Storage ---
GCS_BUCKET=my-bucket-out
GCS_BUCKET_OUTPUT=my-bucket-out/audio_output
USE_GCS=true
GCS_UPLOAD_CHUNK_MB=64

# --- Speech-to-Text v1 ---
STT_LANGUAGE_CODE=es-MX
STT_ENABLE_DIARIZATION=true
STT_MIN_SPEAKERS=2
STT_MAX_SPEAKERS=2
SPEECH_LOCATION=us-central1
SPEECH_RECOGNIZER=telephony-recognizer-v2
TRANSCRIBER_ENGINE=stt_v1_stereo
GEMINI_VERTEX=gemini-3-flash-preview
# --- Rutas locales ---
WORK_DIR=./

# --- Audio Processing ---
NORMALIZE_TARGET_DB=-20
SILENCE_THRESHOLD=0.01

# --- Prompts ---
TRANSCRIPTION_PROMPT_FILE=./src/domain/prompts/transcription_prompt.md.j2
